{
	"name": "@staticmaps/svelte",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vp dev",
		"build": "svelte-package -i src/lib -o dist",
		"build:demo": "vp build",
		"preview": "vp preview",
		"prepare": "svelte-kit sync",
		"test:e2e": "playwright test",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"predev": "pnpm -C ../core run build",
		"precheck": "pnpm -C ../core run build",
		"pretest:e2e": "pnpm -C ../core run build"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/package": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tsconfig/svelte": "5.0.8",
		"sass": "1.106.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"wrangler": "4.152.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@staticmaps/core": "workspace:*"
	}
}
