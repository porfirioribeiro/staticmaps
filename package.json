{
  "name": "staticmaps",
  "author": "Porf\u00edrio Ribeiro <porfirioribeiro@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vite-plus": "catalog:"
  },
  "scripts": {
    "build": "vp run -r build",
    "build:ci": "pnpm install --frozen-lockfile && vp run -r build && pnpm -C packages/svelte run build:demo",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt . --write",
    "format": "vp fmt . --write",
    "test": "pnpm -C packages/core run build && vp run -r test",
    "test:e2e": "pnpm -C packages/svelte exec playwright test",
    "check:dist": "node scripts/check-dist.mjs"
  }
}
